{
  "schemaVersion": 1,
  "id": "truedarkness",
  "version": "${version}",
  "name": "True Darkness",
  "description": "Nights and unlit places (caves, rooms without light) become dramatically darker than vanilla - almost pitch black. The sun, moon and stars are untouched and stay fully visible in the night sky.",
  "authors": [
    "Geord"
  ],
  "contact": {
    "sources": "https://github.com/clainenxx",
    "homepage": "https://github.com/clainenxx"
  },
  "license": "MIT",
  "icon": "assets/truedarkness/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.truedarkness.TrueDarknessClient"
    ]
  },
  "mixins": [
    {
      "config": "truedarkness.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.5",
    "java": ">=21",
    "fabric-api": "*"
  }
}
